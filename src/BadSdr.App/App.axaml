<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BadSdr.App.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter"/><Setter Property="Background" Value="#0B1019"/></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#DEE7F2"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#8798B2"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.section"><Setter Property="Foreground" Value="#8DA4C3"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LetterSpacing" Value="1.5"/></Style>
    <Style Selector="TextBlock.metric"><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#111B2A"/><Setter Property="BorderBrush" Value="#253349"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="32"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="32"/><Setter Property="CornerRadius" Value="5"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#24B8A6"/><Setter Property="Foreground" Value="#07181B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="DataGrid"><Setter Property="Background" Value="#101926"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#202D41"/><Setter Property="RowHeight" Value="33"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="12"/></Style>
  </Application.Styles>
</Application>
